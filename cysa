 {k:'AV',name:'Attack Vector',opts:[['N','Network',.85],['A','Adjacent',.62],['L','Local',.55],['P','Physical',.2]]},
 {k:'AC',name:'Attack Complexity',opts:[['L','Low',.77],['H','High',.44]]},
 {k:'PR',name:'Privileges Required',opts:[['N','None',null],['L','Low',null],['H','High',null]]},
 {k:'UI',name:'User Interaction',opts:[['N','None',.85],['R','Required',.62]]},
 {k:'S',name:'Scope',opts:[['U','Unchanged',null],['C','Changed',null]]},
 {k:'C',name:'Confidentiality',opts:[['H','High',.56],['L','Low',.22],['N','None',0]]},
 {k:'I',name:'Integrity',opts:[['H','High',.56],['L','Low',.22],['N','None',0]]},
 {k:'A',name:'Availability',opts:[['H','High',.56],['L','Low',.22],['N','None',0]]}
];
const PR_VAL={U:{N:.85,L:.62,H:.27},C:{N:.85,L:.68,H:.50}};
let cvssState={AV:'N',AC:'L',PR:'N',UI:'N',S:'U',C:'H',I:'H',A:'H'};

function buildCVSS(){
  const box=document.getElementById('cvssMetrics');box.innerHTML='';
  CVSS_M.forEach(m=>{
    const row=document.createElement('div');row.className='mrow';
    let opts='';
    m.opts.forEach(o=>{opts+='<button class="mopt'+(cvssState[m.k]===o[0]?' on':'')+'" data-k="'+m.k+'" data-v="'+o[0]+'">'+o[0]+' · '+o[1]+'</button>';});
    row.innerHTML='<div class="mrow-top"><span class="mrow-name">'+m.name+'</span><span class="mrow-abbr">'+m.k+'</span></div><div class="mrow-opts">'+opts+'</div>';
    box.appendChild(row);
  });
  box.querySelectorAll('.mopt').forEach(b=>b.onclick=()=>{
    cvssState[b.dataset.k]=b.dataset.v;
    const parent=b.closest('.mrow-opts');parent.querySelectorAll('.mopt').forEach(x=>x.classList.remove('on'));
    b.classList.add('on');
    computeCVSS();
  });
  computeCVSS();
}
function roundup(x){var i=Math.round(x*100000);return (i%10000===0)?i/100000:(Math.floor(i/10000)+1)/10;}
function computeCVSS(){
  const s=cvssState;
  const av={N:.85,A:.62,L:.55,P:.2}[s.AV];
  const ac={L:.77,H:.44}[s.AC];
  const pr=PR_VAL[s.S][s.PR];
  const ui={N:.85,R:.62}[s.UI];
  const cia={H:.56,L:.22,N:0};
  const iss=1-((1-cia[s.C])*(1-cia[s.I])*(1-cia[s.A]));
  let impact;
  if(s.S==='U') impact=6.42*iss;
  else impact=7.52*(iss-0.029)-3.25*Math.pow(iss-0.02,15);
  const exploit=8.22*av*ac*pr*ui;
  let score;
  if(impact<=0) score=0;
  else if(s.S==='U') score=roundup(Math.min(impact+exploit,10));
  else score=roundup(Math.min(1.08*(impact+exploit),10));

  const sev = score===0?['None','var(--muted)']:score<4?['Low','var(--cyan)']:score<7?['Medium','var(--amber)']:score<9?['High','#fb923c']:['Critical','var(--rose)'];
  document.getElementById('cvssNum').textContent=score.toFixed(1);
  document.getElementById('cvssNum').style.color=sev[1];
  const sv=document.getElementById('cvssSev');sv.textContent=sev[0];sv.style.color=sev[1];sv.style.borderColor=sev[1];
  document.getElementById('cvssVec').textContent='CVSS:3.1/AV:'+s.AV+'/AC:'+s.AC+'/PR:'+s.PR+'/UI:'+s.UI+'/S:'+s.S+'/C:'+s.C+'/I:'+s.I+'/A:'+s.A;
  document.getElementById('cvssImpact').textContent=Math.max(0,impact).toFixed(1);
  document.getElementById('cvssExp').textContent=exploit.toFixed(1);
}

/* segmented control */
document.querySelectorAll('#learnSeg .seg-btn').forEach(b=>b.onclick=()=>setSeg(b.dataset.view));
function setSeg(view){
  document.querySelectorAll('#learnSeg .seg-btn').forEach(x=>x.setAttribute('aria-pressed',x.dataset.view===view?'true':'false'));
  document.getElementById('conceptsView').classList.toggle('hide',view!=='concepts');
  document.getElementById('cardsView').classList.toggle('hide',view!=='cards');
  document.getElementById('cvssView').classList.toggle('hide',view!=='cvss');
}
document.getElementById('learnHome').onclick=()=>{show('start');refreshBest();};

/* ============ NAV ============ */
function show(id){['start','quiz','results','learn'].forEach(s=>document.getElementById(s).classList.toggle('hide',s!==id));window.scrollTo({top:0,behavior:'smooth'});}
function refreshBest(){
  try{
    const r=JSON.parse(localStorage.getItem('cysa_best')||'null');
    document.getElementById('bestLine').innerHTML=r?('Best score: <b>'+r.best+'%</b> · '+r.runs+' sessions logged'):'';
  }catch(e){}
}
refreshBest();
