<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CySA+ CS0-003 · Threat Console</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0a1120; --panel:#0f1c33; --panel-2:#0c1730; --raise:#132443;
  --border:#1e3350; --border-soft:#182a45;
  --cyan:#22d3ee; --cyan-dim:#0e7490; --cyan-glow:rgba(34,211,238,.18);
  --green:#34d399; --rose:#fb5c74; --amber:#fbbf24;
  --text:#e6eef8; --muted:#8ba0bd; --faint:#5b7091;
  --d1:#22d3ee; --d2:#a78bfa; --d3:#fbbf24; --d4:#34d399;
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{
  margin:0; background:var(--bg); color:var(--text);
  font-family:'Inter',system-ui,sans-serif; line-height:1.55;
  min-height:100vh;
  background-image:
    linear-gradient(rgba(34,211,238,.025) 1px,transparent 1px),
    linear-gradient(90deg,rgba(34,211,238,.025) 1px,transparent 1px),
    radial-gradient(1200px 600px at 80% -10%,rgba(34,211,238,.06),transparent 60%);
  background-size:44px 44px,44px 44px,100% 100%;
}
.wrap{max-width:860px;margin:0 auto;padding:26px 20px 80px}

/* top console bar */
.console-bar{
  display:flex;align-items:center;gap:10px;
  font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--faint);
  border:1px solid var(--border-soft);border-radius:10px;
  background:var(--panel-2);padding:9px 14px;margin-bottom:22px;letter-spacing:.02em;
}
.dot{width:8px;height:8px;border-radius:50%;background:var(--cyan);box-shadow:0 0 10px var(--cyan)}
.console-bar .cur{color:var(--cyan);animation:blink 1.1s steps(1) infinite}
.console-bar .grow{flex:1}
@keyframes blink{50%{opacity:0}}

h1{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:30px;line-height:1.1;margin:0 0 6px;letter-spacing:-.01em}
h1 .plus{color:var(--cyan)}
.sub{color:var(--muted);font-size:14.5px;margin:0 0 24px;max-width:60ch}
.eyebrow{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--cyan-dim);margin-bottom:10px}

.card{background:var(--panel);border:1px solid var(--border);border-radius:14px;padding:22px}
.card + .card{margin-top:16px}

/* exam facts strip */
.facts{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--border-soft);border:1px solid var(--border-soft);border-radius:12px;overflow:hidden;margin-bottom:22px}
.fact{background:var(--panel-2);padding:13px 14px}
.fact .n{font-family:'JetBrains Mono',monospace;font-weight:700;font-size:18px;color:var(--text)}
.fact .l{font-size:11px;color:var(--muted);margin-top:2px}
@media(max-width:620px){.facts{grid-template-columns:repeat(2,1fr)}}

.field{margin:18px 0}
.field > label{display:block;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--faint);margin-bottom:10px}
.opts{display:flex;flex-wrap:wrap;gap:8px}
.chip{
  font-family:'Inter';font-size:13.5px;color:var(--muted);
  border:1px solid var(--border);background:var(--panel-2);
  padding:9px 14px;border-radius:9px;cursor:pointer;transition:.14s;user-select:none;
}
.chip:hover{border-color:var(--cyan-dim);color:var(--text)}
.chip[aria-pressed="true"]{border-color:var(--cyan);color:var(--bg);background:var(--cyan);font-weight:600}
.chip .tag{font-family:'JetBrains Mono',monospace;font-size:11px;opacity:.7;margin-left:5px}

.btn{
  font-family:'Space Grotesk',sans-serif;font-weight:600;font-size:15px;
  background:var(--cyan);color:#04141b;border:none;border-radius:10px;
  padding:13px 24px;cursor:pointer;transition:.14s;letter-spacing:.01em;
}
.btn:hover{box-shadow:0 0 0 3px var(--cyan-glow);transform:translateY(-1px)}
.btn.ghost{background:transparent;color:var(--cyan);border:1px solid var(--cyan-dim)}
.btn.ghost:hover{border-color:var(--cyan);box-shadow:none}
.btn:disabled{opacity:.4;cursor:not-allowed;transform:none;box-shadow:none}
.btn-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:6px}

.best{font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--faint);margin-top:16px}
.best b{color:var(--green)}

/* quiz screen */
.qhead{display:flex;align-items:center;gap:14px;margin-bottom:16px;font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--muted)}
.qhead .count{color:var(--text)}
.timer{margin-left:auto;padding:4px 11px;border:1px solid var(--border);border-radius:20px;color:var(--cyan);letter-spacing:.05em}
.timer.warn{color:var(--rose);border-color:var(--rose)}
.pbar{height:4px;background:var(--border-soft);border-radius:4px;overflow:hidden;margin-bottom:22px}
.pfill{height:100%;background:linear-gradient(90deg,var(--cyan-dim),var(--cyan));width:0;transition:width .3s ease}

.dbadge{display:inline-flex;align-items:center;gap:7px;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:12px}
.dbadge .sq{width:9px;height:9px;border-radius:2px}
.qtext{font-size:18px;font-weight:500;line-height:1.5;margin:0 0 8px}
pre.snippet{font-family:'JetBrains Mono',monospace;font-size:13px;background:var(--panel-2);border:1px solid var(--border);border-left:3px solid var(--cyan);border-radius:8px;padding:12px 14px;overflow-x:auto;color:#bfe9f5;margin:14px 0}

.answers{display:flex;flex-direction:column;gap:10px;margin-top:18px}
.ans{
  display:flex;gap:13px;align-items:flex-start;text-align:left;
  border:1px solid var(--border);background:var(--panel-2);
  border-radius:11px;padding:14px 16px;cursor:pointer;transition:.13s;color:var(--text);font-size:15px;font-family:'Inter';
}
.ans:hover:not(.locked){border-color:var(--cyan-dim);background:var(--raise)}
.ans .key{font-family:'JetBrains Mono',monospace;font-weight:700;font-size:13px;color:var(--faint);border:1px solid var(--border);border-radius:6px;min-width:26px;height:26px;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px}
.ans.sel{border-color:var(--cyan);background:var(--raise)}
.ans.sel .key{color:var(--cyan);border-color:var(--cyan)}
.ans.correct{border-color:var(--green);background:rgba(52,211,153,.08)}
.ans.correct .key{color:var(--green);border-color:var(--green)}
.ans.wrong{border-color:var(--rose);background:rgba(251,92,116,.07)}
.ans.wrong .key{color:var(--rose);border-color:var(--rose)}
.ans.locked{cursor:default}

.explain{margin-top:16px;border:1px solid var(--border);border-left:3px solid var(--cyan);border-radius:8px;background:var(--panel-2);padding:14px 16px;font-size:14.5px;color:#cdddf0;display:none}
.explain.show{display:block;animation:fade .25s ease}
.explain .verdict{font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;margin-bottom:7px}
.explain .verdict.ok{color:var(--green)} .explain .verdict.no{color:var(--rose)}
@keyframes fade{from{opacity:0;transform:translateY(4px)}to{opacity:1}}

.navrow{display:flex;gap:10px;margin-top:22px;align-items:center}
.navrow .grow{flex:1}

/* results */
.score-hero{text-align:center;padding:30px 20px 24px}
.score-ring{font-family:'Space Grotesk';font-weight:700;font-size:58px;line-height:1;color:var(--text)}
.score-ring .pct{color:var(--cyan)}
.verdict-badge{display:inline-block;font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:.14em;text-transform:uppercase;padding:6px 16px;border-radius:20px;margin-top:14px}
.verdict-badge.pass{color:var(--green);border:1px solid var(--green);background:rgba(52,211,153,.08)}
.verdict-badge.fail{color:var(--amber);border:1px solid var(--amber);background:rgba(251,191,36,.07)}
.score-meta{font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--faint);margin-top:14px}

.dom-row{display:flex;align-items:center;gap:14px;padding:11px 0;border-bottom:1px solid var(--border-soft)}
.dom-row:last-child{border-bottom:none}
.dom-name{font-size:14px;min-width:150px;display:flex;align-items:center;gap:9px}
.dom-name .sq{width:10px;height:10px;border-radius:3px;flex-shrink:0}
.dom-track{flex:1;height:8px;background:var(--panel-2);border-radius:6px;overflow:hidden}
.dom-fill{height:100%;width:0;border-radius:6px;transition:width .7s cubic-bezier(.2,.8,.2,1)}
.dom-val{font-family:'JetBrains Mono',monospace;font-size:12.5px;min-width:74px;text-align:right;color:var(--muted)}
.dom-val .weak{color:var(--rose)}
.weak-note{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--rose);margin-left:6px}

.review-item{border:1px solid var(--border);border-radius:11px;padding:15px 16px;margin-top:12px;background:var(--panel-2)}
.review-item .rq{font-size:14.5px;font-weight:500;margin:0 0 10px}
.review-item .line{font-size:13.5px;margin:4px 0;display:flex;gap:8px}
.review-item .line .lab{font-family:'JetBrains Mono',monospace;font-size:11px;min-width:64px;color:var(--faint);flex-shrink:0;padding-top:2px}
.review-item .yours{color:var(--rose)} .review-item .right{color:var(--green)}
.review-item .exp{color:var(--muted);font-size:13.5px;margin-top:8px;padding-top:8px;border-top:1px solid var(--border-soft)}

.section-label{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--cyan-dim);margin:26px 0 12px;display:flex;align-items:center;gap:10px}
.section-label::after{content:"";flex:1;height:1px;background:var(--border-soft)}

.hide{display:none!important}

/* learn screen */
.learn-topbar{display:flex;align-items:center;gap:12px;margin-bottom:20px}
.seg{display:inline-flex;border:1px solid var(--border);border-radius:10px;overflow:hidden;background:var(--panel-2)}
.seg-btn{font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:.06em;color:var(--muted);background:transparent;border:none;padding:9px 16px;cursor:pointer;transition:.13s}
.seg-btn[aria-pressed="true"]{background:var(--cyan);color:#04141b;font-weight:700}
.learn-topbar .btn{margin-left:auto;padding:9px 16px;font-size:13px}

.lib-dom{margin:26px 0 12px;display:flex;align-items:center;gap:11px;font-family:'Space Grotesk',sans-serif;font-weight:600;font-size:16px}
.lib-dom:first-child{margin-top:4px}
.lib-dom .sq{width:12px;height:12px;border-radius:3px}
.lib-dom .wt{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--faint);margin-left:auto;letter-spacing:.05em}

.topic{border:1px solid var(--border);border-radius:11px;background:var(--panel);margin-bottom:9px;overflow:hidden}
.topic-head{display:flex;align-items:center;gap:12px;padding:14px 16px;cursor:pointer;user-select:none;font-weight:500;font-size:15px;transition:.13s}
.topic-head:hover{background:var(--raise)}
.topic-head .chev{margin-left:auto;color:var(--faint);font-family:'JetBrains Mono',monospace;transition:transform .2s;flex-shrink:0}
.topic.open .chev{transform:rotate(90deg);color:var(--cyan)}
.topic-head .idx{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--cyan-dim);flex-shrink:0}
.topic-body{display:none;padding:2px 18px 18px;border-top:1px solid var(--border-soft)}
.topic.open .topic-body{display:block;animation:fade .2s ease}
.kpt{display:flex;gap:10px;font-size:14px;color:#cddcef;margin:11px 0;line-height:1.5}
.kpt::before{content:"▸";color:var(--cyan-dim);flex-shrink:0}
.kpt b{color:var(--text)}
.ktable{width:100%;border-collapse:collapse;margin:14px 0 4px;font-size:13px}
.ktable th{text-align:left;font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--faint);padding:7px 10px;border-bottom:1px solid var(--border)}
.ktable td{padding:8px 10px;border-bottom:1px solid var(--border-soft);color:#cddcef;vertical-align:top}
.ktable td:first-child{font-family:'JetBrains Mono',monospace;color:var(--cyan);white-space:nowrap}
.ktable tr:last-child td{border-bottom:none}

/* flashcards */
.flash-meta{display:flex;justify-content:space-between;font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--faint);margin-bottom:12px}
.flash{position:relative;min-height:240px;perspective:1400px;cursor:pointer;margin-bottom:16px}
.flash-face{position:absolute;inset:0;backface-visibility:hidden;border:1px solid var(--border);border-radius:16px;padding:30px 26px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;transition:transform .5s cubic-bezier(.3,.8,.3,1)}
.flash-front{background:var(--panel);transform:rotateY(0)}
.flash-back{background:linear-gradient(160deg,var(--raise),var(--panel-2));border-color:var(--cyan-dim);transform:rotateY(180deg)}
.flash.flipped .flash-front{transform:rotateY(-180deg)}
.flash.flipped .flash-back{transform:rotateY(0)}
.flash-lab{font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:.18em;color:var(--cyan-dim);margin-bottom:16px}
.flash-front>div,.flash-back>div{font-family:'Space Grotesk',sans-serif;font-size:20px;font-weight:500;line-height:1.35}
.flash-back>div{color:var(--cyan);font-size:18px}
.flash-hint{position:absolute;bottom:16px;font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--faint);letter-spacing:.1em}
.flash-nav{display:flex;gap:10px}
.flash-nav .btn{flex:1}
@media(prefers-reduced-motion:reduce){.flash-face{transition:none}}

/* cvss calculator */
.cvss-score{text-align:center;padding:24px 20px}
.cvss-big{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:64px;line-height:1;color:var(--text)}
.cvss-sev{display:inline-block;font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:.14em;text-transform:uppercase;padding:5px 16px;border-radius:20px;margin-top:12px;border:1px solid var(--border)}
.cvss-vector{font-family:'JetBrains Mono',monospace;font-size:12.5px;color:var(--cyan);margin-top:16px;word-break:break-all;background:var(--panel-2);border:1px solid var(--border);border-radius:8px;padding:9px 12px}
.cvss-sub{display:flex;justify-content:center;gap:24px;margin-top:14px;font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--muted)}
.cvss-sub b{color:var(--text)}
.mrow{border:1px solid var(--border);border-radius:11px;background:var(--panel);padding:13px 15px;margin-bottom:9px}
.mrow-top{display:flex;align-items:baseline;gap:10px;margin-bottom:10px}
.mrow-name{font-size:14px;font-weight:500}
.mrow-abbr{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--cyan-dim);letter-spacing:.05em}
.mrow-opts{display:flex;flex-wrap:wrap;gap:7px}
.mopt{font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--muted);border:1px solid var(--border);background:var(--panel-2);padding:7px 12px;border-radius:8px;cursor:pointer;transition:.12s}
.mopt:hover{border-color:var(--cyan-dim);color:var(--text)}
.mopt.on{background:var(--cyan);color:#04141b;border-color:var(--cyan);font-weight:700}
.cvss-tip{font-size:13px;color:var(--muted);border-left:3px solid var(--cyan-dim);padding:10px 14px;background:var(--panel-2);border-radius:0 8px 8px 0;margin-top:16px;line-height:1.55}
.cvss-tip b{color:var(--text)}
.foot{text-align:center;font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--faint);margin-top:36px;line-height:1.7}

@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
@media(max-width:560px){h1{font-size:25px}.dom-name{min-width:120px}.wrap{padding:20px 15px 60px}}
</style>
</head>
<body>
<div class="wrap">

  <div class="console-bar">
    <span class="dot"></span>
    <span>SOC-TRAINER v1 · CS0-003 · target 750/900</span>
    <span class="grow"></span>
    <span>ready<span class="cur">_</span></span>
  </div>

  <!-- ============ START SCREEN ============ -->
  <section id="start">
    <div class="eyebrow">CompTIA Cybersecurity Analyst+</div>
    <h1>CySA<span class="plus">+</span> Threat Console</h1>
    <p class="sub">Active-recall trainer for CS0-003. Practice mode gives instant feedback; exam mode runs the clock and grades you at the end — with a per-domain breakdown that flags exactly where you're leaking points.</p>

    <div class="facts">
      <div class="fact"><div class="n">85</div><div class="l">max questions</div></div>
      <div class="fact"><div class="n">165<span style="font-size:12px;color:var(--muted)">m</span></div><div class="l">time limit</div></div>
      <div class="fact"><div class="n">750</div><div class="l">pass / 900</div></div>
      <div class="fact"><div class="n">4</div><div class="l">domains</div></div>
    </div>

    <div class="card">
      <div class="field">
        <label>Mode</label>
        <div class="opts" id="modeOpts">
          <button class="chip" data-mode="learn" aria-pressed="false">Learn <span class="tag">study concepts</span></button>
          <button class="chip" data-mode="practice" aria-pressed="true">Practice <span class="tag">instant feedback</span></button>
          <button class="chip" data-mode="exam" aria-pressed="false">Exam <span class="tag">timed · graded</span></button>
        </div>
      </div>

      <div class="field">
        <label>Domain focus</label>
        <div class="opts" id="domOpts">
          <button class="chip" data-dom="all" aria-pressed="true">All domains</button>
          <button class="chip" data-dom="1" aria-pressed="false">1 · Security Ops <span class="tag">33%</span></button>
          <button class="chip" data-dom="2" aria-pressed="false">2 · Vuln Mgmt <span class="tag">30%</span></button>
          <button class="chip" data-dom="3" aria-pressed="false">3 · Incident Resp <span class="tag">20%</span></button>
          <button class="chip" data-dom="4" aria-pressed="false">4 · Reporting <span class="tag">17%</span></button>
        </div>
      </div>

      <div class="field" id="lenField">
        <label>Length</label>
        <div class="opts" id="lenOpts">
          <button class="chip" data-len="10" aria-pressed="false">10 questions</button>
          <button class="chip" data-len="20" aria-pressed="true">20 questions</button>
          <button class="chip" data-len="0" aria-pressed="false">Full bank <span class="tag">120</span></button>
          <button class="chip" data-len="85" aria-pressed="false">Exam sim <span class="tag">85 · 165 min</span></button>
        </div>
      </div>

      <div class="btn-row">
        <button class="btn" id="startBtn">Start session →</button>
      </div>
      <div class="best" id="bestLine"></div>
    </div>

    <div class="foot">Original question bank · healthcare-flavored · not a braindump<br>Pair with CertMaster / Jason Dion for full coverage · exam retires 22 Dec 2026</div>
  </section>

  <!-- ============ QUIZ SCREEN ============ -->
  <section id="quiz" class="hide">
    <div class="qhead">
      <span class="count"><span id="qNow">1</span>/<span id="qTot">20</span></span>
      <span id="qMode">PRACTICE</span>
      <span class="timer" id="timer">00:00</span>
    </div>
    <div class="pbar"><div class="pfill" id="pfill"></div></div>

    <div class="card">
      <div class="dbadge" id="dBadge"><span class="sq"></span><span id="dName"></span></div>
      <p class="qtext" id="qText"></p>
      <div id="qSnip"></div>
      <div class="answers" id="answers"></div>
      <div class="explain" id="explain"></div>
    </div>

    <div class="navrow">
      <button class="btn ghost" id="prevBtn">← Prev</button>
      <span class="grow"></span>
      <button class="btn ghost" id="quitBtn">Quit</button>
      <button class="btn" id="nextBtn">Next →</button>
    </div>
  </section>

  <!-- ============ LEARN SCREEN ============ -->
  <section id="learn" class="hide">
    <div class="eyebrow" id="learnEyebrow">Study library</div>
    <div class="learn-topbar">
      <div class="seg" id="learnSeg">
        <button class="seg-btn" data-view="concepts" aria-pressed="true">Concepts</button>
        <button class="seg-btn" data-view="cards" aria-pressed="false">Flashcards</button>
        <button class="seg-btn" data-view="cvss" aria-pressed="false">CVSS Calc</button>
      </div>
      <button class="btn ghost" id="learnHome">← Console</button>
    </div>

    <div id="conceptsView">
      <div id="libBody"></div>
    </div>

    <div id="cardsView" class="hide">
      <div class="flash-meta"><span id="flashCount">1 / 1</span><span id="flashDom"></span></div>
      <div class="flash" id="flashCard" tabindex="0" role="button" aria-label="Flip card">
        <div class="flash-face flash-front"><span class="flash-lab">PROMPT</span><div id="flashFront"></div><span class="flash-hint">tap to reveal</span></div>
        <div class="flash-face flash-back"><span class="flash-lab">ANSWER</span><div id="flashBack"></div></div>
      </div>
      <div class="flash-nav">
        <button class="btn ghost" id="flashPrev">← Prev</button>
        <button class="btn ghost" id="flashShuffle">Shuffle</button>
        <button class="btn" id="flashNext">Next →</button>
      </div>
    </div>

    <div id="cvssView" class="hide">
      <div class="cvss-score card">
        <div class="cvss-big"><span id="cvssNum">0.0</span></div>
        <div id="cvssSev" class="cvss-sev">—</div>
        <div class="cvss-vector" id="cvssVec">—</div>
        <div class="cvss-sub"><span>Impact <b id="cvssImpact">0.0</b></span><span>Exploitability <b id="cvssExp">0.0</b></span></div>
      </div>
      <div id="cvssMetrics"></div>
      <div class="cvss-tip">Tip: <b>AV:N + AC:L + PR:N + UI:N</b> pushes the exploitability sub-score up; <b>S:C</b> lets impact cross a boundary and adds a 1.08× multiplier. Those four are the usual reason a score reaches Critical.</div>
    </div>
  </section>

