    <div class="card">
      <div class="score-hero">
        <div class="score-ring"><span class="pct" id="rPct">0</span>%</div>
        <div id="rBadge" class="verdict-badge">—</div>
        <div class="score-meta" id="rMeta"></div>
      </div>
    </div>

    <div class="section-label">Signal by domain</div>
    <div class="card" id="domBreakdown"></div>

    <div class="section-label" id="reviewLabel">Missed — review these</div>
    <div id="reviewList"></div>

    <div class="btn-row" style="margin-top:26px">
      <button class="btn" id="againBtn">Retry weak domains →</button>
      <button class="btn ghost" id="homeBtn">Back to console</button>
    </div>
    <div class="foot">Track your misses by domain. The one you fail most is the one to cram first.</div>
  </section>

