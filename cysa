<script>
/* ============ QUESTION BANK (original) ============ */
const DOMAINS={
 1:{name:"Security Operations",color:"var(--d1)"},
 2:{name:"Vulnerability Management",color:"var(--d2)"},
 3:{name:"Incident Response & Mgmt",color:"var(--d3)"},
 4:{name:"Reporting & Communication",color:"var(--d4)"}
};
const Q=[
{d:1,q:"A nursing-station workstation opens an outbound HTTPS connection to the same external IP every 60 seconds, with small consistent payloads — even at 2–3 AM. Most indicative of what?",o:["Normal Windows Update","C2 beaconing","DDoS attack","Normal backup job"],a:1,e:"Fixed interval + small consistent payloads + off-hours = classic beaconing to a C2 server. Updates aren't a steady 60s cadence all night; a DDoS is inbound flooding; backups run scheduled with larger volumes."},
{d:1,q:"An analyst sees Windows Event ID 1102 on a Domain Controller. Primary concern?",o:["Multiple failed logons","The audit log was cleared — attacker covering tracks","A new user account was created","A new process was launched"],a:1,e:"1102 = 'audit log was cleared' — an anti-forensics red flag (MITRE Defense Evasion – Indicator Removal). 4625 = failed logon, 4720 = user created, 4688 = new process."},
{d:1,q:"Which email-authentication mechanism uses a digital signature to verify a message wasn't altered in transit?",o:["SPF","DKIM","DMARC","TLS"],a:1,e:"DKIM signs with a private key, verified via the public key in DNS → integrity + sender authentication. SPF only lists authorized senders; DMARC is the policy + alignment; TLS encrypts transport but doesn't sign the body."},
{d:1,q:"Core principle of a Zero Trust architecture?",o:["Trust every device inside the perimeter","Never trust, always verify — continuous auth + least privilege","A strong perimeter firewall is enough","A VPN secures everything"],a:1,e:"Zero Trust removes implicit internal trust; every request is authenticated/authorized regardless of location, plus microsegmentation + least privilege. The others are the old castle-and-moat model or single controls."},
{d:1,q:"In threat-intelligence sharing, which component is the transport protocol?",o:["STIX","TAXII","MITRE ATT&CK","OVAL"],a:1,e:"TAXII = the delivery pipeline; STIX = the language describing threats. 'STIX = language, TAXII = pipe.' ATT&CK is a TTP framework; OVAL is a SCAP assessment language."},
{d:1,q:"Which technique detects a compromised account by comparing current behavior to a user's normal baseline?",o:["DLP","UEBA","SPF","NAC"],a:1,e:"UEBA baselines behavior (logon times, locations, resources) and alerts on deviation — strong against insider threats / account takeover. DLP prevents exfil, SPF authenticates email, NAC controls device access."},
{d:1,q:"An attacker uses certutil.exe to download a payload. This technique is best classified as:",o:["Zero-day exploit","Living-off-the-Land (LOLBin)","SQL injection","Buffer overflow"],a:1,e:"certutil, mshta, rundll32, regsvr32, wmic, powershell are LOLBins — legitimate OS binaries abused to evade AV (Defense Evasion). It exploits no vulnerability."},
{d:1,q:"On the Pyramid of Pain, which indicator is hardest for an attacker to change when blocked?",o:["Hash values","IP addresses","Domain names","TTPs"],a:3,e:"Hashes/IPs/domains change trivially; changing TTPs (how they operate) is costly and hard → hunting on TTPs is more durable. That's the ATT&CK philosophy."},
{d:1,q:"Why is time synchronization (NTP) a prerequisite for a SIEM?",o:["To save bandwidth","To correlate events across sources on an accurate timeline","To encrypt logs","To compress logs"],a:1,e:"Out-of-sync logs make event sequencing impossible → flawed investigations. NTP/UTC normalization gives every timestamp a common reference."},
{d:1,q:"Which correctly distinguishes an IOC from an IOA?",o:["IOC is behavior in progress; IOA is a past artifact","IOC = artifact of something that already happened (reactive); IOA = behavior/intent in progress (proactive)","They are identical","IOCs are network-only, IOAs host-only"],a:1,e:"IOC (hash/IP/domain) = a compromise already occurred (reactive). IOA = behavior/intent in progress, detected earlier (proactive). Both span network and host."},
{d:1,q:"Key difference between EDR and XDR?",o:["EDR is Linux-only; XDR is Windows-only","EDR focuses on endpoints; XDR extends correlation across endpoint + network + email + cloud","XDR requires no agent","EDR is a next-gen firewall"],a:1,e:"EDR = endpoint telemetry/response. XDR = 'extended', correlating multiple sources for a broader picture."},
{d:1,q:"In Wireshark, which display filter shows only DNS queries?",o:["tcp.port == 443","http.request","dns","ip.addr == 8.8.8.8"],a:2,e:"'dns' filters on the DNS protocol. 443 = HTTPS, http.request = HTTP requests, ip.addr = all traffic to/from one IP (not DNS-specific)."},
{d:1,q:"Running a suspicious file in an isolated environment to observe runtime behavior is called:",o:["Static analysis","Dynamic analysis (sandboxing)","Hashing","Fuzzing"],a:1,e:"Sandboxing = dynamic analysis (execute to observe). Static analysis inspects without running; hashing only fingerprints; fuzzing injects malformed input to find bugs."},
{d:1,q:"An executable exhibits very high entropy. This most often suggests:",o:["The file is clean and normal","The file may be packed/encrypted (possible malware)","The file is plain text","The file is corrupted"],a:1,e:"High entropy = randomized data, typically from packing/encryption to evade AV signatures — a malware red flag. Plain text has low entropy."},
{d:1,q:"A parent process explorer.exe spawns powershell.exe, which spawns cmd.exe running an encoded command. Best next step?",o:["Ignore — normal Windows behavior","Investigate the process tree as a likely malicious execution chain","Reboot the machine immediately","Delete powershell.exe"],a:1,e:"Encoded PowerShell in an unusual process tree is a strong Execution/Defense-Evasion signal. Rebooting destroys volatile evidence; deleting the binary breaks legitimate use and doesn't remove the threat."},
{d:1,q:"Steady DNS queries to long, random-looking subdomains of one domain, carrying data, indicate:",o:["Normal CDN traffic","DNS tunneling (covert channel / exfiltration)","A DHCP issue","SSL stripping"],a:1,e:"Encoding data into DNS subdomain labels to a controlled domain = DNS tunneling, used for C2/exfil over an often-allowed protocol. CDN/DHCP don't produce encoded random labels."},
{d:1,q:"Which MFA factor is considered the most phishing-resistant?",o:["SMS one-time code","FIDO2 / WebAuthn hardware key","Email verification link","Security questions"],a:1,e:"FIDO2/WebAuthn binds the credential to the origin and uses hardware-backed keys → resistant to phishing/replay. SMS is SIM-swap/interception-prone; email links and security questions are weak."},

{d:2,q:"Given CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H — which is correct?",o:["Requires admin privileges to exploit","Remotely exploitable, no privileges, no user interaction — very high severity","Requires user interaction","Only affects availability"],a:1,e:"AV:N remote, AC:L easy, PR:N no privileges, UI:N no interaction, C/I/A:H full impact → Critical. PR:N means NO privileges needed; UI:N means no interaction; impact spans C, I, and A."},
{d:2,q:"Which scan type gives the deepest results with the fewest false positives?",o:["Non-credentialed","Credentialed (authenticated)","Passive","External"],a:1,e:"Credentialed scans log in → see patch level, config, registry → accurate, fewer false positives. Non-credentialed and external are shallower; passive only listens."},
{d:2,q:"Assessing vulnerabilities on a PACS imaging system and infusion pumps — safest approach?",o:["High-intensity active scan","Passive scanning","Credentialed active scan","Aggressive Nmap -A"],a:1,e:"IoMT/OT devices are fragile; active scanning can crash a device treating a patient (safety risk). Passive scanning is non-intrusive. The others are intrusive."},
{d:2,q:"Which scan result is most dangerous because it creates a false sense of security?",o:["True positive","False positive","False negative","True negative"],a:2,e:"A false negative = a real vulnerability the scanner misses → you believe you're secure while exposed. False positives waste effort but don't let real risk slip through."},
{d:2,q:"The CISA KEV catalog is used to prioritize:",o:["Vulnerabilities with the lowest CVSS","Vulnerabilities being actively exploited in the wild → patch urgently","Theoretical vulnerabilities with no PoC","Expired vulnerabilities"],a:1,e:"KEV lists vulns actively exploited in the wild → top priority regardless of CVSS. Combine with EPSS (exploitation probability)."},
{d:2,q:"How do CVE and CWE differ?",o:["CVE is a weakness type; CWE is a specific vuln","CVE is a specific vulnerability ID; CWE is a weakness category","Both are numeric scores","CVE is for web, CWE for network"],a:1,e:"CVE identifies a specific vuln (CVE-2024-xxxxx); CWE classifies a weakness type (CWE-89 SQLi, CWE-79 XSS). CVSS is the score."},
{d:2,q:"Which are components of SCAP?",o:["STIX and TAXII","OVAL and XCCDF","SPF and DKIM","RTO and RPO"],a:1,e:"SCAP includes OVAL, XCCDF, CCE, CPE, CVE, CVSS — automation standards for vuln/compliance. The others are threat-intel sharing, email auth, and DR metrics."},
{d:2,q:"What does the Nmap flag -sV do?",o:["UDP scan","Detect the version of services on open ports","OS detection","Skip host discovery"],a:1,e:"-sV = service/version detection. -sU UDP, -O OS detection, -Pn no ping."},
{d:2,q:"A medical device can't be patched due to vendor lock-in. Best way to reduce risk?",o:["Ignore it","Compensating controls: isolate on a segmented VLAN + enhanced monitoring","Remove the device from the hospital","Continuously run active scans"],a:1,e:"When direct remediation isn't possible, apply compensating controls — segmentation/isolation + monitoring. Ignoring = blind risk acceptance; removal is infeasible; active scans risk crashing it."},
{d:2,q:"Most effective defense against SQL Injection?",o:["Longer passwords","Parameterized queries / prepared statements","Enabling HTTPS","Installing antivirus"],a:1,e:"Parameterized queries separate data from the SQL command so input can't become code. HTTPS/AV/passwords don't prevent SQLi."},
{d:2,q:"Primary defense against Cross-Site Scripting (XSS)?",o:["Parameterized queries","Output encoding + Content Security Policy (CSP)","Rate limiting","Port knocking"],a:1,e:"XSS is stopped by encoding output (escaping HTML/JS) + CSP + input validation. Parameterized queries address SQLi."},
{d:2,q:"Which techniques reduce buffer-overflow exploitability?",o:["ASLR + DEP/NX + stack canaries","HTTPS everywhere","MFA","DNS filtering"],a:0,e:"ASLR (address randomization), DEP/NX (non-executable data), and stack canaries (detect overwrites) are the classic trio against overflows."},
{d:2,q:"What does EPSS add on top of CVSS?",o:["Patch cost","The probability a vulnerability will be exploited soon","Lines of buggy code","Vendor name"],a:1,e:"CVSS measures severity; EPSS measures likelihood of real-world exploitation. Combine both + KEV to prioritize."},
{d:2,q:"Staff laptops roam and are frequently offline. Best scan type?",o:["Agentless network scan","Agent-based scan","External scan","Passive-only"],a:1,e:"Agent-based scans keep collecting and reporting offline, syncing when back online. Agentless/external need the device online in-network during the scan."},
{d:2,q:"In CVSS, what does Scope: Changed (S:C) mean?",o:["The score changes over time","The exploit can impact resources beyond the vulnerable component's security authority","The vendor changed the CVE","The attack requires physical access"],a:1,e:"Scope: Changed means the impact crosses a security boundary (e.g., a hypervisor bug affecting guest VMs), which raises the score. Temporal metrics handle change-over-time."},
{d:2,q:"Which tool is a web-application scanner rather than a network scanner?",o:["Nmap","OWASP ZAP","hping","Angry IP Scanner"],a:1,e:"OWASP ZAP (and Burp Suite) scan web apps for issues like XSS/SQLi. Nmap/hping/Angry IP are network/host discovery tools."},

{d:3,q:"By order of volatility, which data is collected FIRST?",o:["Hard disk","Backup tapes","RAM (memory)","Archived logs"],a:2,e:"Order: registers/cache → RAM → network state → disk → logs → backups (last). RAM holds processes, connections, keys — lost on power-off, so collect first."},
{d:3,q:"Purpose of chain of custody in forensics?",o:["Speed up the investigation","Document who held evidence, when and where — ensuring legal admissibility/integrity","Compress evidence","Encrypt the disk"],a:1,e:"Chain of custody is the evidence-handling log. Without it evidence can be thrown out in court. Unrelated to speed/compression/encryption."},
{d:3,q:"An analyst hashes a disk image at acquisition and again after analysis. Why?",o:["To compress the image","To prove integrity — data wasn't altered during handling","To encrypt the image","To remove malware"],a:1,e:"Matching before/after hashes proves the evidence is unchanged and trustworthy. Hashing doesn't compress/encrypt/clean."},
{d:3,q:"Correct order of the NIST SP 800-61 IR lifecycle?",o:["Detection → Preparation → Recovery → Lessons Learned","Preparation → Detection & Analysis → Containment/Eradication/Recovery → Post-Incident Activity","Containment → Preparation → Detection → Recovery","Recovery → Containment → Detection → Preparation"],a:1,e:"NIST 4 phases: Preparation → Detection & Analysis → Containment/Eradication/Recovery → Post-Incident. Prep is first; lessons learned feeds back into prep."},
{d:3,q:"During a ransomware incident, the most appropriate FIRST containment action is:",o:["Immediately re-image all servers","Isolate infected hosts from the network to stop the spread","Pay the ransom","Delete all logs"],a:1,e:"Containment = stop the spread first (isolate/segment). Re-imaging is recovery; paying isn't a standard step; deleting logs destroys evidence."},
{d:3,q:"An attacker uses stolen credentials to move host-to-host inside the network. Which ATT&CK tactic?",o:["Initial Access","Lateral Movement","Exfiltration","Reconnaissance"],a:1,e:"Moving sideways between hosts = Lateral Movement. Initial Access is first entry; Exfiltration is data-out; Reconnaissance is scouting."},
{d:3,q:"In the Cyber Kill Chain, packaging an exploit + payload into a weapon (e.g., a macro-laden doc) is which step?",o:["Delivery","Weaponization","Exploitation","Installation"],a:1,e:"Weaponization = coupling exploit with payload. Delivery = sending it; Exploitation = triggering the vuln; Installation = persistence."},
{d:3,q:"The Diamond Model of Intrusion Analysis has which four vertices?",o:["People, Process, Technology, Data","Adversary, Capability, Infrastructure, Victim","Prepare, Detect, Contain, Recover","Confidentiality, Integrity, Availability, Safety"],a:1,e:"Diamond Model = Adversary – Capability – Infrastructure – Victim per intrusion event."},
{d:3,q:"After eradicating malware, the team re-images a server and restores from a clean backup. Which phase?",o:["Preparation","Detection","Recovery","Reconnaissance"],a:2,e:"Re-image + restore from clean backup + validate + monitor = Recovery (return to safe operation)."},

{d:4,q:"Under the HIPAA Breach Notification Rule, a breach affecting ≥ 500 individuals requires:",o:["No reporting","Notify affected individuals, HHS OCR, and the media — within 60 days","Report internally only","Report to the FBI within 24 hours"],a:1,e:"≥ 500 records → notify individuals + HHS OCR + media within 60 days. Under 500 is reported annually."},
{d:4,q:"Under GDPR, the supervisory authority must be notified of a breach within:",o:["30 days","60 days","72 hours","7 days"],a:2,e:"GDPR: notify the supervisory authority within 72 hours of becoming aware, where there's risk to individuals."},
{d:4,q:"A typical inhibitor to remediation in healthcare is:",o:["A vendor patch is available","A proprietary/legacy medical device that can't be patched due to vendor lock-in","The IT team is overstaffed","The budget is unlimited"],a:1,e:"Inhibitors = barriers: proprietary/legacy systems, MOU/SLA, disallowed downtime, degrading functionality, governance. Vendor-locked devices are the classic case."},
{d:4,q:"How do MTTD and MTTR differ?",o:["MTTD = time to recover; MTTR = time to detect","MTTD = mean time to detect; MTTR = mean time to respond/remediate","They measure the same thing","MTTD is only for vulns, MTTR only for email"],a:1,e:"MTTD = average time to detect; MTTR = average time to respond/remediate. Related: MTTC (contain) and dwell time."},
{d:4,q:"Reporting vulnerability posture to the executive board — best approach?",o:["List every CVE with detailed CVSS vectors","Focus on business risk, financial impact; use dashboards; avoid jargon","Send raw scan output only","Send packet captures"],a:1,e:"Executives want business risk + cost + trends. Technical teams get the CVE/CVSS detail. Tailoring to the audience is the Domain 4 skill."},
{d:4,q:"What does dwell time measure?",o:["How long a scan takes","How long an attacker persists before being detected","Server boot time","Network latency"],a:1,e:"Dwell time = compromise-to-detection duration. Longer dwell = more damage; reduce it by improving MTTD."},
{d:4,q:"In an incident with likely legal implications, which stakeholder must be engaged early for reporting obligations and evidence preservation?",o:["Marketing","Legal / General Counsel","Facilities","Sales"],a:1,e:"Legal advises on regulatory obligations, legal hold, chain of custody, and law-enforcement coordination. PR handles messaging; legal duties belong to Legal."},

{d:1,q:"SIEM sequence on one host in 3 minutes: 4625 (x40) → 4624 → 4672 → 4720 → 1102. Best interpretation?",snip:"4625 (x40)  →  4624  →  4672  →  4720  →  1102",o:["Routine user activity","Brute force → successful logon → admin rights → new account (persistence) → log cleared (evasion)","A failed backup job","Scheduled patch installation"],a:1,e:"40 failures (brute force) → one success → 4672 admin privileges → 4720 new account (persistence) → 1102 log cleared (anti-forensics). Isolate the host, disable the new account, capture RAM before power-off, hunt lateral movement."},
{d:2,q:"Vector CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:C/C:H/I:H/A:H — severity rating?",snip:"AV:N  AC:L  PR:N  UI:N  S:C  C:H  I:H  A:H",o:["Low","Medium","High","Critical"],a:3,e:"Remote (AV:N), easy (AC:L), no privileges/interaction (PR:N/UI:N), Scope Changed (impact beyond the component), full C/I/A impact → Critical (9.0–10.0). If it's Epic/PACS and in KEV, patch as an emergency."},
{d:3,q:"Order these ransomware actions: (a) Lessons learned (b) Isolate hosts (c) Restore from clean backup (d) Identify scope & IoCs (e) Remove malware. Correct sequence?",o:["b → d → e → c → a","d → b → e → c → a","d → e → b → c → a","a → d → b → e → c"],a:1,e:"d Identify (Detection) → b Isolate (Containment) → e Remove (Eradication) → c Restore (Recovery) → a Lessons learned (Post-Incident). Collect volatile evidence (RAM before disk) BEFORE re-imaging."},
{d:3,q:"Match to ATT&CK: HTTPS beaconing every 60s to an external IP is which tactic?",o:["Initial Access","Command & Control","Exfiltration","Persistence"],a:1,e:"Regular beaconing to an external controller = Command & Control (C2). Initial Access is first entry; Exfiltration is data-out; Persistence maintains access."},
{d:4,q:"Which report tells leadership WHAT to fix, WHO owns it, and BY WHEN?",o:["Compliance report","Action plan","Packet capture","CVSS vector list"],a:1,e:"An action plan assigns remediation tasks, owners, and deadlines. A compliance report states adherence status; the others are raw technical artifacts."},
{d:1,q:"Which threat-intel source is freely/publicly gathered rather than paid/proprietary?",o:["Closed vendor feed","OSINT (Open-Source Intelligence)","HUMINT from a paid informant","A proprietary ISAC premium feed"],a:1,e:"OSINT is publicly available intel (blogs, public feeds, WHOIS). Closed/proprietary feeds and premium ISAC tiers are paid; HUMINT is human-sourced."}
,
{d:1,q:"Which protocol is primarily used for enterprise SSO with XML-based assertions?",o:["OAuth 2.0","SAML","RADIUS","LDAP"],a:1,e:"SAML uses XML assertions for enterprise SSO/federation. OAuth 2.0 handles authorization (often with OIDC for auth); RADIUS/LDAP are directory/AAA protocols."},
{d:1,q:"An IDS differs from an IPS in that:",o:["An IDS blocks traffic inline; an IPS only alerts","An IDS detects and alerts; an IPS can also block inline","They are identical","An IPS only works on hosts"],a:1,e:"IDS = detect + alert (passive/out-of-band). IPS = inline, can drop/block malicious traffic. Snort/Suricata can run in either mode."},
{d:1,q:"Snort and Suricata primarily rely on what to detect known threats?",o:["Machine learning only","Signatures/rules","Blockchain","DNS caching"],a:1,e:"Both are signature/rule-based (with some anomaly features). Zeek focuses on network behavior analysis rather than signatures."},
{d:1,q:"NetFlow data is most useful for:",o:["Reading full packet payloads","Analyzing traffic metadata (who talked to whom, volume, ports)","Decrypting TLS","Editing firewall rules"],a:1,e:"NetFlow captures flow metadata (src/dst, ports, bytes) — great for detecting exfil/beaconing patterns at scale. It doesn't capture payload; full packet capture does."},
{d:1,q:"What does Sysmon add beyond default Windows logging?",o:["Nothing new","Detailed process creation, network connections, and hashes for richer telemetry","Disk encryption","A firewall"],a:1,e:"Sysmon logs granular events (process creation with command line & hashes, network connections, image loads) that default auditing lacks — valuable for EDR-style detection."},
{d:1,q:"A honeypot is deployed primarily to:",o:["Serve production traffic","Lure and observe attackers / detect intrusions","Replace a firewall","Encrypt backups"],a:1,e:"A honeypot is a decoy to attract and study attackers and to alert on unauthorized access (active defense). It carries no production value, so any interaction is suspicious."},
{d:1,q:"Regular C2 beaconing that adds random delay between check-ins is using:",o:["Encryption","Jitter (to evade interval-based detection)","Compression","Tunneling"],a:1,e:"Jitter randomizes the beacon interval to avoid the tell-tale fixed cadence that defenders detect. It's an evasion technique layered on C2."},
{d:1,q:"A phishing email links to a page that mimics the Office 365 login. The goal is most likely:",o:["Denial of service","Credential harvesting","Data encryption","Port scanning"],a:1,e:"A fake login page is built to capture credentials (Credential Access via phishing). It's the entry to account takeover."},
{d:1,q:"Which detection method flags activity that deviates from a learned normal baseline?",o:["Signature-based","Anomaly-based","Allow-list","Hashing"],a:1,e:"Anomaly-based detection alerts on deviations from baseline (good for novel/zero-day behavior). Signature-based needs a known pattern."},
{d:1,q:"A DNS sinkhole is used to:",o:["Speed up DNS","Redirect malicious domain lookups to a controlled server to block/observe C2","Encrypt DNS","Cache all queries"],a:1,e:"A sinkhole answers known-bad domains with a controlled IP, cutting off C2 and letting defenders see which hosts tried to reach them."},
{d:1,q:"Base64-encoded PowerShell launched with -EncodedCommand most likely indicates:",o:["Normal admin scripting","An attempt to obfuscate a malicious command","A Windows Update","A backup job"],a:1,e:"Encoded PowerShell is a common obfuscation to hide intent from analysts/AV. Combined with an odd process tree it's a strong malicious-execution signal."},
{d:1,q:"Which is the most reliable indicator to hunt on because it is costly for an attacker to change?",o:["File hash","Source IP","Behavioral TTP","User-agent string"],a:2,e:"On the Pyramid of Pain, TTPs are hardest and most expensive to change. Hashes/IPs/strings are trivially rotated."},
{d:1,q:"CASB is deployed primarily to:",o:["Scan for buffer overflows","Enforce policy and visibility over cloud application usage (including shadow IT)","Replace antivirus","Manage certificates"],a:1,e:"A Cloud Access Security Broker sits between users and cloud apps to enforce DLP, access policy, and surface shadow IT."},
{d:1,q:"Which log field is essential to correlate events across multiple systems?",o:["Font color","Accurate timestamp (synchronized clock)","File icon","Screen resolution"],a:1,e:"Synchronized timestamps (via NTP) let a SIEM order events across sources. Without them, correlation and timelines break."},
{d:1,q:"Full packet capture vs flow data — the main trade-off is:",o:["Flow data stores payloads; PCAP does not","PCAP gives full payload detail but huge storage; flow data is lightweight metadata","They are the same","PCAP cannot see IPs"],a:1,e:"Full PCAP captures everything (deep analysis) but is storage-heavy. NetFlow-style flow data is compact metadata, ideal for long-term, large-scale visibility."},
{d:1,q:"Kerberos is the default authentication protocol in which environment?",o:["Public web apps","On-prem Windows Active Directory domains","IoT sensors","Email relays"],a:1,e:"Kerberos underpins Windows AD authentication (tickets). Attacks like Kerberoasting/Golden Ticket target it (Credential Access)."},
{d:1,q:"Which is a host-based indicator of compromise?",o:["Beaconing to an external IP","A new unauthorized local admin account","DNS tunneling","Large outbound data transfer"],a:1,e:"A new unauthorized admin account is host-based. Beaconing, DNS tunneling, and large outbound transfers are network-based indicators."},
{d:1,q:"Deprecated protocols like SSLv3 and TLS 1.0 should be:",o:["Kept for compatibility","Disabled in favor of TLS 1.2/1.3","Used only for admin traffic","Encrypted twice"],a:1,e:"Old SSL/TLS versions have known cryptographic weaknesses (POODLE, BEAST). Disable them; require TLS 1.2+ (ideally 1.3)."},
{d:1,q:"A rogue device suddenly appearing on a segmented clinical VLAN should be treated as:",o:["Routine","A potential unauthorized/malicious device requiring investigation","A printer","A DNS server"],a:1,e:"Unexpected devices on a controlled segment are a network IOC — could be an attacker foothold or an unmanaged/unauthorized asset. Investigate and quarantine."},
{d:1,q:"OSINT differs from a closed/proprietary feed because OSINT is:",o:["Always more accurate","Publicly and freely gathered","Paid subscription only","Human-source only"],a:1,e:"OSINT is publicly available (blogs, public feeds, WHOIS). Closed/proprietary feeds are paid; HUMINT is human-sourced intelligence."},
{d:1,q:"Which artifact best reveals what a suspicious process actually did at runtime?",o:["A static string dump","Dynamic (sandbox) execution behavior","The file icon","The file name"],a:1,e:"Dynamic analysis observes real behavior (network calls, file/registry changes) that static inspection alone may miss."},

{d:2,q:"A CVE identifier like CVE-2024-1234 represents:",o:["A weakness category","A single specific, publicly disclosed vulnerability","A CVSS score","A product name"],a:1,e:"CVE = a unique ID for one specific disclosed vulnerability. CWE is the weakness category, CPE the product name, CVSS the score."},
{d:2,q:"Changing Privileges Required from None to High in CVSS will:",o:["Raise the score","Lower the score","Not affect the score","Change the CVE ID"],a:1,e:"Requiring higher privileges makes exploitation harder, lowering the exploitability sub-score and thus the base score."},
{d:2,q:"An authenticated (credentialed) scan requires:",o:["Physical access","Valid host credentials to log in and inspect internally","A packet capture","A honeypot"],a:1,e:"Credentialed scans log in to read patch level, config, and registry — deeper and more accurate than external, non-credentialed scans."},
{d:2,q:"Nmap reports a port as 'filtered'. This usually means:",o:["The port is open and responding","A firewall is dropping/blocking probes so state is undetermined","The service crashed","The host is offline"],a:1,e:"'Filtered' = probes are blocked (often by a firewall), so Nmap can't determine open/closed. 'Open' responds; 'closed' is reachable but no service."},
{d:2,q:"In risk terms, a vulnerability is:",o:["A potential danger source","A weakness that a threat could exploit","The likelihood times impact","An attacker"],a:1,e:"Vulnerability = a weakness. Threat = the potential danger/actor. Risk = likelihood × impact of a threat exploiting a vulnerability."},
{d:2,q:"Before deploying a patch to production clinical systems, best practice is to:",o:["Deploy immediately everywhere","Test in a staging environment first, then roll out","Skip testing to save time","Only patch on weekends"],a:1,e:"Patches can break functionality (a remediation inhibitor). Test in staging, validate, then deploy — especially for patient-facing systems."},
{d:2,q:"Quantitative risk uses SLE × ARO to calculate:",o:["CVSS base score","ALE (Annualized Loss Expectancy)","Dwell time","MTTR"],a:1,e:"ALE = SLE (Single Loss Expectancy) × ARO (Annual Rate of Occurrence). It expresses expected annual loss for cost-benefit decisions."},
{d:2,q:"According to OWASP Top 10, which has ranked as the #1 web application risk?",o:["Broken Access Control","Clickjacking","Weak passwords","Open ports"],a:0,e:"Broken Access Control topped the OWASP Top 10 (2021). It covers IDOR, privilege bypass, and missing authorization checks."},
{d:2,q:"A payload of ../../../../etc/passwd is characteristic of:",o:["SQL injection","Directory/path traversal","XSS","CSRF"],a:1,e:"Traversal sequences (../) attempt to escape the web root to read arbitrary files. Mitigate by canonicalizing paths and validating input."},
{d:2,q:"Insecure deserialization can lead to:",o:["Only cosmetic bugs","Remote code execution or object injection","Faster performance","Better logging"],a:1,e:"Untrusted serialized objects can be crafted to execute code or tamper with application logic. Validate/avoid deserializing untrusted data."},
{d:2,q:"Hardcoded credentials found in a code repository should be:",o:["Left in place","Rotated immediately and moved to a secrets manager","Emailed to the team","Committed to a public branch"],a:1,e:"Exposed secrets must be rotated (assume compromised) and stored in a vault/secrets manager, never in code. SCA/secret scanners catch these."},
{d:2,q:"Container images should be scanned to detect:",o:["Only CPU usage","Vulnerable packages and misconfigurations before deployment","Screen resolution","Font issues"],a:1,e:"Image scanning finds vulnerable dependencies and misconfig in the image supply chain, ideally enforced in CI/CD and admission control."},
{d:2,q:"After remediating a vulnerability, you should:",o:["Close the ticket immediately","Rescan/validate that the fix actually resolved the finding","Delete the asset","Ignore it"],a:1,e:"Validation via rescan confirms remediation worked (no lingering false negative). Only then is the finding truly closed."},
{d:2,q:"A scanner flags a vulnerability, but manual review shows the service is not actually present. This is a:",o:["True positive","False positive","False negative","True negative"],a:1,e:"A false positive = flagged but not real. Triage/validation reduces wasted effort; contrast with the more dangerous false negative (missed real vuln)."},
{d:2,q:"An SBOM (Software Bill of Materials) primarily helps you:",o:["Encrypt traffic","Know which components/dependencies you run so you can react to new CVEs","Scan ports","Manage passwords"],a:1,e:"An SBOM inventories software components so that when a new CVE (e.g., in a library) drops, you can quickly find affected systems — key for supply-chain risk."},
{d:2,q:"The safest prioritization approach combines CVSS with:",o:["Alphabetical order","Asset criticality, KEV, and EPSS (real-world exploit context)","Vendor name","Scan duration"],a:1,e:"Raw CVSS isn't enough. Weight by asset value and whether it's actively exploited (KEV) or likely to be (EPSS)."},
{d:2,q:"Nmap flag -sS performs a:",o:["UDP scan","SYN (half-open) stealth scan","Version detection","OS fingerprint"],a:1,e:"-sS sends SYN without completing the handshake (stealthier, faster). -sU UDP, -sV version, -O OS."},
{d:2,q:"A control applied when you cannot patch a legacy device is called a:",o:["Corrective root fix","Compensating control","Preventive patch","Detective baseline"],a:1,e:"A compensating control (e.g., isolate + monitor) reduces risk when direct remediation isn't feasible — common for vendor-locked medical devices."},
{d:2,q:"Infrastructure as Code (IaC) templates should be scanned for:",o:["Only syntax errors","Security misconfigurations before provisioning","Font kerning","Battery level"],a:1,e:"IaC scanning catches insecure defaults (open security groups, public buckets) before resources are deployed — shift-left cloud security."},

{d:3,q:"Copying patient data to an external server over HTTPS is which ATT&CK tactic?",o:["Persistence","Exfiltration","Reconnaissance","Execution"],a:1,e:"Moving data out of the environment = Exfiltration. Often preceded by Collection (staging/compressing) internally."},
{d:3,q:"Creating a scheduled task that re-launches malware after reboot is which tactic?",o:["Persistence","Exfiltration","Discovery","Impact"],a:0,e:"Scheduled tasks, Run keys, and services that survive reboot are Persistence mechanisms."},
{d:3,q:"Vertical privilege escalation means:",o:["Accessing another user's account at the same level","Gaining higher privileges than originally granted (e.g., user to admin)","Moving between hosts","Deleting logs"],a:1,e:"Vertical = gaining higher privileges (user→admin). Horizontal = accessing another account at the same privilege level."},
{d:3,q:"A write blocker is used during acquisition to:",o:["Speed up copying","Prevent any modification to the source evidence","Encrypt the disk","Compress data"],a:1,e:"A write blocker ensures the original media is read-only during imaging, preserving integrity (verified by matching hashes)."},
{d:3,q:"A legal hold requires the organization to:",o:["Delete relevant data","Preserve data relevant to anticipated litigation","Encrypt all backups","Notify the media"],a:1,e:"Legal hold suspends normal deletion so potentially relevant evidence is preserved for litigation/investigation."},
{d:3,q:"A playbook differs from a runbook in that a playbook is:",o:["A single automated script","A broader response strategy for a scenario; a runbook is step-by-step procedures","Only for executives","A hardware device"],a:1,e:"Playbook = the overall response approach for an incident type; runbook = the detailed operational steps. SOAR often automates runbook actions."},
{d:3,q:"In DR planning, a hot site is:",o:["An empty facility","A fully equipped, near-real-time replica ready for immediate failover","A cloud backup only","A tape archive"],a:1,e:"Hot = ready immediately (lowest RTO, highest cost); warm = partial; cold = empty space needing setup."},
{d:3,q:"Short-term containment during an incident typically means:",o:["Rebuilding all systems","Quickly isolating affected hosts to limit spread while preserving evidence","Deleting the malware source","Notifying customers"],a:1,e:"Short-term containment (e.g., network isolation) stops spread fast without destroying forensic data; long-term containment applies more durable fixes before recovery."},
{d:3,q:"MAC times (Modified, Accessed, Created) on files are useful in forensics to:",o:["Encrypt files","Build a timeline of activity","Compress evidence","Assign CVSS scores"],a:1,e:"File timestamps help reconstruct when files were created/altered/accessed, supporting timeline analysis during Detection & Analysis."},
{d:3,q:"When would re-imaging be preferred over cleaning malware in place?",o:["Never","When the extent of compromise is uncertain or persistence may remain","Only for printers","Only on weekends"],a:1,e:"If you can't be certain all persistence/backdoors are removed, re-image from a known-good baseline and restore clean data — safer than in-place cleaning."},
{d:3,q:"The FIRST responder priority when a running compromised host is found is to:",o:["Power it off immediately","Capture volatile evidence (memory, connections) before it's lost","Format the disk","Reinstall the OS"],a:1,e:"Powering off destroys RAM/volatile data. Follow the order of volatility — capture memory and network state first, then proceed."},
{d:3,q:"Isolation vs segmentation as containment: isolation is:",o:["Grouping many systems together","Cutting a specific compromised host off entirely","Encrypting traffic","Adding users"],a:1,e:"Isolation removes a host from communication entirely; segmentation restricts groups of systems into zones to limit blast radius."},
{d:3,q:"Root cause analysis primarily answers:",o:["Who to blame","Why the incident happened so it can be prevented from recurring","How to bill the client","What color to use in reports"],a:1,e:"RCA (5 Whys, fishbone) identifies the underlying cause to drive corrective action and improve the IR plan — a post-incident activity."},

{d:4,q:"An executive summary in a security report should emphasize:",o:["Raw packet captures","Business impact and risk in plain language","Full CVE lists","Regex patterns"],a:1,e:"Executives need business context and risk/cost, not technical minutiae. Technical detail goes to the technical audience."},
{d:4,q:"A compliance report primarily communicates:",o:["Attacker TTPs","Adherence status to a standard or regulation","Packet flows","Server temperatures"],a:1,e:"Compliance reports show whether controls meet a framework/regulation (HIPAA, PCI DSS). Action plans define remediation tasks and owners."},
{d:4,q:"Including SLA compliance in vulnerability reporting helps leadership see:",o:["Font choices","Whether remediation is happening within agreed timeframes","Attacker identities","Disk usage"],a:1,e:"SLA metrics show if the team is remediating within committed windows — a key KPI for accountability and trend tracking."},
{d:4,q:"Under HIPAA, breaches are reported to which federal body?",o:["FBI only","HHS Office for Civil Rights (OCR)","SEC","FCC"],a:1,e:"HIPAA breaches go to HHS OCR (and affected individuals; media if ≥500 in a jurisdiction), within 60 days."},
{d:4,q:"When law enforcement is involved in an incident, it is critical to:",o:["Wipe the systems","Maintain chain of custody for all evidence","Post details publicly","Skip documentation"],a:1,e:"Preserving chain of custody keeps evidence admissible. Coordinate with Legal and law enforcement before altering systems."},
{d:4,q:"Reducing dwell time indicates:",o:["Slower detection","Improved detection speed (attackers caught sooner)","More false positives","Longer investigations"],a:1,e:"Dwell time is compromise-to-detection. Lower is better — it means detection (MTTD) improved, limiting damage."},
{d:4,q:"Lessons learned from an incident should primarily:",o:["Be discarded","Feed back into preparation to improve the IR plan and playbooks","Only go to marketing","Stay with one analyst"],a:1,e:"Post-incident lessons close the loop, updating the IRP, playbooks, and controls to prevent recurrence."},
{d:4,q:"Which stakeholder controls external messaging during a breach?",o:["Facilities","Public Relations / Communications","Warehouse","Procurement"],a:1,e:"PR/Communications manages public and customer messaging; Legal advises on obligations; both coordinate to avoid missteps."},
{d:4,q:"An action plan differs from a compliance report because the action plan specifies:",o:["Only historical data","What to fix, who owns it, and by when","Attacker motives","Server uptime"],a:1,e:"Action plans are forward-looking task lists with owners and deadlines; compliance reports state current adherence status."},
{d:4,q:"The NIST Cybersecurity Framework core functions are:",o:["Plan, Do, Check, Act","Identify, Protect, Detect, Respond, Recover","Scan, Patch, Report","Encrypt, Backup, Restore"],a:1,e:"NIST CSF: Identify, Protect, Detect, Respond, Recover — a common structure for organizing security programs and reporting."},
{d:4,q:"A metric showing MTTR trending downward over quarters indicates:",o:["Worsening response","Improving response/remediation speed","More vulnerabilities","Less staff"],a:1,e:"Falling MTTR means the team responds/remediates faster over time — a positive trend worth highlighting to leadership."},
{d:4,q:"An MOU that limits when a vendor system can be touched is best described as:",o:["A remediation accelerator","An inhibitor to remediation","A CVSS metric","A forensic tool"],a:1,e:"Contractual constraints (MOU/SLA) that restrict changes are inhibitors to remediation, alongside legacy/proprietary systems and downtime limits."}
];

/* ============ STATE ============ */
let cfg={mode:"practice",dom:"all",len:20};
let sess=null,timerId=null;

/* chip groups */
document.querySelectorAll('#modeOpts .chip').forEach(c=>c.onclick=()=>{
  setChip('modeOpts',c);cfg.mode=c.dataset.mode;
  const learn=cfg.mode==='learn';
  document.getElementById('lenField').classList.toggle('hide',learn);
  document.getElementById('startBtn').textContent=learn?'Open study library →':'Start session →';
});
document.querySelectorAll('#domOpts .chip').forEach(c=>c.onclick=()=>{setChip('domOpts',c);cfg.dom=c.dataset.dom});
document.querySelectorAll('#lenOpts .chip').forEach(c=>c.onclick=()=>{setChip('lenOpts',c);cfg.len=parseInt(c.dataset.len)});
function setChip(group,el){document.querySelectorAll('#'+group+' .chip').forEach(x=>x.setAttribute('aria-pressed','false'));el.setAttribute('aria-pressed','true');}

/* ============ START ============ */
function shuffle(a){for(let i=a.length-1;i>0;i--){const j=Math.random()*(i+1)|0;[a[i],a[j]]=[a[j],a[i]];}return a;}

document.getElementById('startBtn').onclick=()=>{
  if(cfg.mode==='learn'){openLibrary();return;}
  if(cfg.len===85){ startExamSim(); return; }
  let pool=Q.map((q,i)=>({...q,_i:i}));
  if(cfg.dom!=="all") pool=pool.filter(q=>q.d==+cfg.dom);
  shuffle(pool);
  let n=cfg.len===0?pool.length:Math.min(cfg.len,pool.length);
  pool=pool.slice(0,n);
  sess={list:pool,cur:0,ans:new Array(pool.length).fill(null),mode:cfg.mode,start:Date.now()};
  show('quiz');
  document.getElementById('qMode').textContent=cfg.mode.toUpperCase();
  document.getElementById('qTot').textContent=pool.length;
  document.getElementById('prevBtn').style.visibility=cfg.mode==='exam'?'visible':'hidden';
  startTimer();
  renderQ();
};

function startExamSim(){
  // full weighted 85-question paper (33/30/20/17), all domains, timed 165 min
  const want={1:28,2:26,3:17,4:14};
  let paper=[];
  Object.keys(want).forEach(d=>{
    let dp=Q.map((q,i)=>({...q,_i:i})).filter(q=>q.d==+d);
    shuffle(dp);paper=paper.concat(dp.slice(0,want[d]));
  });
  shuffle(paper);
  sess={list:paper,cur:0,ans:new Array(paper.length).fill(null),mode:'exam',start:Date.now(),sim:true};
  show('quiz');
  document.getElementById('qMode').textContent='EXAM · SIM';
  document.getElementById('qTot').textContent=paper.length;
  document.getElementById('prevBtn').style.visibility='visible';
  startTimer();renderQ();
}

function startTimer(){
  clearInterval(timerId);
  const tEl=document.getElementById('timer');
  if(sess.mode==='exam'){
    let left=sess.sim?165*60:sess.list.length*90;
    const tick=()=>{
      const m=String(left/60|0).padStart(2,'0'),s=String(left%60).padStart(2,'0');
      tEl.textContent=m+':'+s; tEl.classList.toggle('warn',left<=Math.max(30,sess.list.length*10));
      if(left<=0){clearInterval(timerId);finish();} left--;
    };tick();timerId=setInterval(tick,1000);
  }else{
    let up=0;
    const tick=()=>{const m=String(up/60|0).padStart(2,'0'),s=String(up%60).padStart(2,'0');tEl.textContent=m+':'+s;up++;};
    tick();timerId=setInterval(tick,1000);
  }
}

/* ============ RENDER QUESTION ============ */
function renderQ(){
  const it=sess.list[sess.cur];
  const dm=DOMAINS[it.d];
  document.getElementById('qNow').textContent=sess.cur+1;
  document.getElementById('pfill').style.width=((sess.cur)/sess.list.length*100)+'%';
  const badge=document.getElementById('dBadge');
  badge.querySelector('.sq').style.background=dm.color;
  document.getElementById('dName').textContent='Domain '+it.d+' · '+dm.name;
  document.getElementById('qText').textContent=it.q;
  document.getElementById('qSnip').innerHTML=it.snip?('<pre class="snippet">'+it.snip+'</pre>'):'';

  const box=document.getElementById('answers');box.innerHTML='';
  const chosen=sess.ans[sess.cur];
  it.o.forEach((opt,idx)=>{
    const b=document.createElement('button');
    b.className='ans';b.innerHTML='<span class="key">'+'ABCD'[idx]+'</span><span>'+opt+'</span>';
    if(chosen!==null){
      if(sess.mode==='practice'){
        b.classList.add('locked');
        if(idx===it.a) b.classList.add('correct');
        else if(idx===chosen) b.classList.add('wrong');
      }else{ if(idx===chosen) b.classList.add('sel'); }
    }
    b.onclick=()=>choose(idx);
    box.appendChild(b);
  });

  const exp=document.getElementById('explain');
  if(sess.mode==='practice' && chosen!==null){
    const ok=chosen===it.a;
    exp.className='explain show';
    exp.innerHTML='<div class="verdict '+(ok?'ok':'no')+'">'+(ok?'✓ Correct':'✕ Incorrect — answer: '+'ABCD'[it.a])+'</div>'+it.e;
  }else{exp.className='explain';exp.innerHTML='';}

  const next=document.getElementById('nextBtn');
  next.textContent=(sess.cur===sess.list.length-1)?'Finish →':'Next →';
  document.getElementById('prevBtn').disabled=sess.cur===0;
}

function choose(idx){
  if(sess.mode==='practice' && sess.ans[sess.cur]!==null) return; // lock after answer in practice
  sess.ans[sess.cur]=idx;
  renderQ();
}

document.getElementById('nextBtn').onclick=()=>{
  if(sess.mode==='practice' && sess.ans[sess.cur]===null) return; // must answer first
  if(sess.cur<sess.list.length-1){sess.cur++;renderQ();}
  else finish();
};
document.getElementById('prevBtn').onclick=()=>{if(sess.cur>0){sess.cur--;renderQ();}};
document.getElementById('quitBtn').onclick=()=>{if(confirm('Quit this session? Progress is lost.')){clearInterval(timerId);show('start');refreshBest();}};

/* ============ RESULTS ============ */
function finish(){
  clearInterval(timerId);
  const perDom={1:{c:0,t:0},2:{c:0,t:0},3:{c:0,t:0},4:{c:0,t:0}};
  let correct=0;const missed=[];
  sess.list.forEach((it,i)=>{
    perDom[it.d].t++;
    if(sess.ans[i]===it.a){correct++;perDom[it.d].c++;}
    else missed.push({it,chosen:sess.ans[i]});
  });
  const pct=Math.round(correct/sess.list.length*100);
  const pass=pct>=83;
  const secs=Math.round((Date.now()-sess.start)/1000);

  document.getElementById('rPct').textContent=pct;
  const badge=document.getElementById('rBadge');
  badge.className='verdict-badge '+(pass?'pass':'fail');
  badge.textContent=pass?'On target ✓':'Below 750 target';
  document.getElementById('rMeta').textContent=correct+' / '+sess.list.length+' correct  ·  '+Math.floor(secs/60)+'m '+(secs%60)+'s  ·  '+sess.mode+' mode';

  // domain bars
  const bd=document.getElementById('domBreakdown');bd.innerHTML='';
  Object.keys(perDom).forEach(d=>{
    const o=perDom[d];if(o.t===0)return;
    const p=Math.round(o.c/o.t*100);const weak=p<70;
    const dm=DOMAINS[d];
    const row=document.createElement('div');row.className='dom-row';
    row.innerHTML=
      '<div class="dom-name"><span class="sq" style="background:'+dm.color+'"></span>D'+d+' · '+dm.name+'</div>'+
      '<div class="dom-track"><div class="dom-fill" style="background:'+dm.color+'"></div></div>'+
      '<div class="dom-val"><span class="'+(weak?'weak':'')+'">'+o.c+'/'+o.t+' · '+p+'%</span>'+(weak?'<span class="weak-note"> ⚑</span>':'')+'</div>';
    bd.appendChild(row);
    requestAnimationFrame(()=>{setTimeout(()=>{row.querySelector('.dom-fill').style.width=p+'%';},60);});
  });

  // review
  const rl=document.getElementById('reviewList');rl.innerHTML='';
  document.getElementById('reviewLabel').style.display=missed.length?'flex':'none';
  if(!missed.length){
    rl.innerHTML='<div class="card" style="text-align:center;color:var(--green);font-family:JetBrains Mono,monospace;font-size:13px">Clean sweep — no misses. Nice.</div>';
  }
  missed.forEach(m=>{
    const it=m.it;const div=document.createElement('div');div.className='review-item';
    div.innerHTML=
      '<div class="dbadge" style="margin-bottom:8px"><span class="sq" style="width:8px;height:8px;border-radius:2px;background:'+DOMAINS[it.d].color+'"></span>Domain '+it.d+'</div>'+
      '<p class="rq">'+it.q+'</p>'+
      (m.chosen!==null?'<div class="line"><span class="lab">You</span><span class="yours">'+'ABCD'[m.chosen]+'. '+it.o[m.chosen]+'</span></div>':'<div class="line"><span class="lab">You</span><span class="yours">— (skipped)</span></div>')+
      '<div class="line"><span class="lab">Correct</span><span class="right">'+'ABCD'[it.a]+'. '+it.o[it.a]+'</span></div>'+
      '<div class="exp">'+it.e+'</div>';
    rl.appendChild(div);
  });

  // persist (works on GitHub Pages; silently skipped where storage is blocked)
  try{
    const key='cysa_best';
    const prev=JSON.parse(localStorage.getItem(key)||'{"best":0,"runs":0}');
    const rec={best:Math.max(prev.best||0,pct),runs:(prev.runs||0)+1};
    localStorage.setItem(key,JSON.stringify(rec));
  }catch(e){}

  // set retry to weakest domain
  const weakest=Object.keys(perDom).filter(d=>perDom[d].t).sort((a,b)=>(perDom[a].c/perDom[a].t)-(perDom[b].c/perDom[b].t))[0];
  document.getElementById('againBtn').dataset.dom=weakest||'all';

  show('results');
}

document.getElementById('againBtn').onclick=(e)=>{
  const d=e.currentTarget.dataset.dom||'all';
  cfg.dom=d;
  // reflect on start chips
  setChip('domOpts',document.querySelector('#domOpts .chip[data-dom="'+d+'"]')||document.querySelector('#domOpts .chip[data-dom="all"]'));
  document.getElementById('startBtn').click();
};
document.getElementById('homeBtn').onclick=()=>{show('start');refreshBest();};

