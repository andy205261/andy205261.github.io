/* ---- Library render ---- */
function openLibrary(){
  const scope=cfg.dom;
  document.getElementById('learnEyebrow').textContent=scope==='all'?'Study library · all domains':'Study library · Domain '+scope;
  buildConcepts(scope);
  buildFlash(scope);
  buildCVSS();
  // default to concepts view
  setSeg('concepts');
  show('learn');
}
function buildConcepts(scope){
  const body=document.getElementById('libBody');body.innerHTML='';
  const doms=scope==='all'?[1,2,3,4]:[+scope];
  const wt={1:'33%',2:'30%',3:'20%',4:'17%'};
  doms.forEach(d=>{
    const head=document.createElement('div');head.className='lib-dom';
    head.innerHTML='<span class="sq" style="background:'+DOMAINS[d].color+'"></span>Domain '+d+' · '+DOMAINS[d].name+'<span class="wt">'+wt[d]+'</span>';
    body.appendChild(head);
    KNOWLEDGE[d].forEach((t,i)=>{
      const card=document.createElement('div');card.className='topic'+((scope!=='all'&&i===0)?' open':(scope==='all'&&d===doms[0]&&i===0?' open':''));
      let inner='';
      if(t.p) t.p.forEach(pt=>inner+='<div class="kpt"><span>'+pt+'</span></div>');
      if(t.table){
        inner+='<table class="ktable"><thead><tr>'+t.table.head.map(h=>'<th>'+h+'</th>').join('')+'</tr></thead><tbody>';
        t.table.rows.forEach(r=>inner+='<tr>'+r.map(c=>'<td>'+c+'</td>').join('')+'</tr>');
        inner+='</tbody></table>';
      }
      card.innerHTML='<div class="topic-head"><span class="idx">'+String(i+1).padStart(2,'0')+'</span>'+t.h+'<span class="chev">›</span></div><div class="topic-body">'+inner+'</div>';
      card.querySelector('.topic-head').onclick=()=>card.classList.toggle('open');
      body.appendChild(card);
    });
  });
}

/* ---- Flashcards ---- */
let fcList=[],fcIdx=0;
function buildFlash(scope){
  fcList=(scope==='all'?FLASHCARDS.slice():FLASHCARDS.filter(c=>c.d==+scope));
  shuffle(fcList);fcIdx=0;renderFlash();
}
function renderFlash(){
  if(!fcList.length)return;
  const c=fcList[fcIdx];
  const card=document.getElementById('flashCard');card.classList.remove('flipped');
  document.getElementById('flashFront').textContent=c.f;
  document.getElementById('flashBack').textContent=c.b;
  document.getElementById('flashCount').textContent=(fcIdx+1)+' / '+fcList.length;
  const dn=document.getElementById('flashDom');dn.textContent='Domain '+c.d;dn.style.color=DOMAINS[c.d].color;
}
document.getElementById('flashCard').onclick=function(){this.classList.toggle('flipped');};
document.getElementById('flashCard').onkeydown=function(e){if(e.key===' '||e.key==='Enter'){e.preventDefault();this.classList.toggle('flipped');}};
document.getElementById('flashNext').onclick=()=>{fcIdx=(fcIdx+1)%fcList.length;renderFlash();};
document.getElementById('flashPrev').onclick=()=>{fcIdx=(fcIdx-1+fcList.length)%fcList.length;renderFlash();};
document.getElementById('flashShuffle').onclick=()=>{shuffle(fcList);fcIdx=0;renderFlash();};

